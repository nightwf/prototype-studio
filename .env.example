# Copy this file to .env.production on the server. Never commit the real file.
POSTGRES_USER=prototype
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=prototype_studio
DATABASE_URL=postgres://prototype:replace-with-a-long-url-safe-password@db:5432/prototype_studio
BASE_URL=https://studio.example.com
INVITE_CODES=replace-with-one-or-more-private-invite-codes
